    "def grade(m):\n",
    "    return \"A\" if m >= 90 else \"B\" if m >= 75 else \"C\"\n",
    "\n",
    "print(marks.apply(grade))                                # apply runs a function on every value\n",
    "print(colours.map({\"Red\": \"R\", \"Blue\": \"B\", \"Green\": \"G\"}))   # map swaps values using a dict"
   ]
