    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "120\n",
      "40\n",
      "Banana       40\n",
      "Jackfruit    90\n",
      "dtype: int64\n",
      "Not found\n"
     ]
    }
   ],
   "source": [
    "print(prices.iloc[0])            # first value\n",
    "print(prices.loc[\"Banana\"])       # by label\n",
    "print(prices.iloc[1:3])           # positions 1 and 2\n",
    "print(prices.get(\"Apple\", \"Not found\"))"
   ]
